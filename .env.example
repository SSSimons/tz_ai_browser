OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Необязательно: совместимый с OpenAI API адрес, например https://proxy.example/v1
# OPENAI_BASE_URL=
AGENT_REASONING_EFFORT=low
AGENT_MAX_STEPS=100
# 0 - без лимита числа API-запросов. Учитываются сжатие и финальная проверка.
AGENT_MAX_API_CALLS=0
AGENT_MAX_OUTPUT_TOKENS=5000
# Автоматические повторы запросов при сетевых ошибках отключены.
AGENT_API_MAX_RETRIES=0
# Раньше сжимаем длинную историю, чтобы не отправлять её целиком на каждом шаге.
AGENT_CONTEXT_CHARS=32000
# Включите для записи кадров и последующего экспорта видео.
AGENT_RECORD_ACTIONS=false
# Постоянные сведения пользователя; локальный поиск не расходует API-токены.
AGENT_KNOWLEDGE_PATH=.knowledge/facts.json
AGENT_TOOL_TIMEOUT_SECONDS=45
AGENT_HEADLESS=false
# Отдельный постоянный профиль; первый вход выполните через browser-agent login.
AGENT_PROFILE_DIR=.browser-profile
# Укажите путь, если Chrome не найден автоматически. Рекомендуется Chrome.
# AGENT_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Подключение к уже запущенному браузеру вместо запуска через SeleniumBase:
# AGENT_CDP_URL=http://127.0.0.1:9222
AGENT_ARTIFACTS_DIR=artifacts
